# /etc/yijiexingtu/app.env -- root:root 0600; never upload this completed file.
FIELD_KEY=REPLACE_WITH_ORIGINAL_32_BYTE_BASE64
BACKUP_KEY=REPLACE_WITH_ORIGINAL_32_BYTE_BASE64
HMAC_KEY=REPLACE_WITH_ORIGINAL_AT_LEAST_32_CHARACTERS
PW_PEPPER=REPLACE_WITH_ORIGINAL_AT_LEAST_32_CHARACTERS
PLATFORM_PHONE_HMAC_KEY=REPLACE_WITH_ORIGINAL_AT_LEAST_32_CHARACTERS
# Already initialized: a new random 32+ character setup key is permitted by §9.
PLATFORM_SETUP_KEY=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
DEEPSEEK_API_KEY=REPLACE_WITH_VALID_DEEPSEEK_KEY
TENANT_HOST=edu.yijiexingtu.com
CONSOLE_HOST=ops.yijiexingtu.com
TURNSTILE_MODE=off
ACCESS_MODE=off
REFERRALS_MODE=off
DB_PATH=/var/lib/yijiexingtu/crm.sqlite
DIST_DIR=/opt/yijiexingtu/current/dist
BACKUP_WORKER_PATH=/opt/yijiexingtu/current/backup-dist/backup-worker.js
PORT=8787
MAX_BODY_BYTES=33554432
COS_REGION=ap-shanghai
COS_BUCKET_MEDIA=REPLACE_MEDIA_BUCKET_APPID
COS_BUCKET_BACKUPS=REPLACE_BACKUP_BUCKET_APPID
COS_AUTH=role
COS_ROLE_NAME=yxt-cos-role
# Backup alternative only: COS_AUTH=keys and set both COS_SECRET_ID/COS_SECRET_KEY.
# Do not set AI_PROVIDER. Do not rotate the five original data/login/backup keys.
