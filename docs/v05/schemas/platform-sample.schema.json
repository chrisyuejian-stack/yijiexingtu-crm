{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yijiexingtu:contract:v05:platform-sample:draft-01",
  "$ref": "#/$defs/platformSample",
  "$defs": {
    "money": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000000,
      "multipleOf": 0.01
    },
    "moneyOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/money"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "idOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "multipleOf": 0.01
    },
    "quantityOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}$"
    },
    "month": {
      "type": "string",
      "pattern": "^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])$"
    },
    "basic": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "student_name": {
          "const": ""
        },
        "grade": {
          "const": ""
        },
        "plan_date": {
          "type": "null"
        },
        "direction": {
          "type": "string",
          "maxLength": 200
        },
        "direction_en": {
          "type": "string",
          "maxLength": 200
        },
        "english_enabled": {
          "type": "boolean"
        },
        "cover_visible": {
          "type": "boolean"
        },
        "cover_eyebrow": {
          "type": "string",
          "maxLength": 200
        },
        "cover_subtitle": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "visible",
        "student_name",
        "grade",
        "plan_date",
        "direction",
        "direction_en",
        "english_enabled",
        "cover_visible",
        "cover_eyebrow",
        "cover_subtitle"
      ],
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 50
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "max"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "maxLength": 12000
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/score"
          },
          "maxItems": 20
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "maxItems": 30
        }
      },
      "required": [
        "visible",
        "title",
        "text",
        "scores",
        "tags"
      ],
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "visible",
        "title",
        "text"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "date",
        "name",
        "note"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "start_month": {
          "anyOf": [
            {
              "$ref": "#/$defs/month"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_month": {
          "anyOf": [
            {
              "$ref": "#/$defs/month"
            },
            {
              "type": "null"
            }
          ]
        },
        "teaching_weeks": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "weeks_note": {
          "type": "string",
          "maxLength": 1000
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 30
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 50
        },
        "node_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 30
        },
        "stage_type_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "name",
        "stage_type_key",
        "start_month",
        "end_month",
        "goals",
        "nodes"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          },
          "maxItems": 100
        }
      },
      "required": [
        "visible",
        "title",
        "stages"
      ],
      "additionalProperties": false
    },
    "timelineItem": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "enum": [
            "grade_exam",
            "competition",
            "art_exam",
            "application_deadline",
            "performance",
            "other"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "source_key": {
          "$ref": "#/$defs/idOrNull"
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "date",
        "name",
        "type",
        "note",
        "source_key"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timelineItem"
          },
          "maxItems": 200
        }
      },
      "required": [
        "visible",
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "qty": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "units": {
              "$ref": "#/$defs/quantityOrNull"
            }
          },
          "required": [
            "units"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "terms": {
              "$ref": "#/$defs/quantityOrNull"
            }
          },
          "required": [
            "terms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "semesters": {
              "$ref": "#/$defs/quantityOrNull"
            }
          },
          "required": [
            "semesters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "months": {
              "$ref": "#/$defs/quantityOrNull"
            }
          },
          "required": [
            "months"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "packages": {
              "$ref": "#/$defs/quantityOrNull"
            }
          },
          "required": [
            "packages"
          ],
          "additionalProperties": false
        }
      ]
    },
    "includes": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "form": {
          "type": "string",
          "maxLength": 100
        },
        "schedule_text": {
          "type": "string",
          "maxLength": 500
        },
        "duration_text": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "label",
        "form",
        "schedule_text",
        "duration_text"
      ],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "stage_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "pricing_source": {
          "enum": [
            "catalog",
            "manual"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "name_en": {
          "type": "string",
          "maxLength": 200
        },
        "frequency_text": {
          "type": "string",
          "maxLength": 500
        },
        "minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            {
              "type": "null"
            }
          ]
        },
        "billing_mode": {
          "enum": [
            "per_unit",
            "per_term",
            "per_semester",
            "per_month",
            "package"
          ]
        },
        "qty": {
          "$ref": "#/$defs/qty"
        },
        "teaching_units": {
          "$ref": "#/$defs/quantityOrNull"
        },
        "units_per_package": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "includes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/includes"
          },
          "maxItems": 50
        },
        "ai_filled": {
          "type": "boolean"
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "group_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "course_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_tbd": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "key",
        "stage_key",
        "group_key",
        "pricing_source",
        "course_key",
        "billing_mode",
        "qty"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pricing_source": {
                "const": "catalog"
              }
            }
          },
          "then": {
            "properties": {
              "course_key": {
                "$ref": "#/$defs/stableKey"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pricing_source": {
                "const": "manual"
              }
            }
          },
          "then": {
            "properties": {
              "course_key": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": {
                "const": "per_unit"
              }
            }
          },
          "then": {
            "properties": {
              "qty": {
                "type": "object",
                "properties": {
                  "units": {
                    "$ref": "#/$defs/quantityOrNull"
                  }
                },
                "required": [
                  "units"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": {
                "const": "per_term"
              }
            }
          },
          "then": {
            "properties": {
              "qty": {
                "type": "object",
                "properties": {
                  "terms": {
                    "$ref": "#/$defs/quantityOrNull"
                  }
                },
                "required": [
                  "terms"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": {
                "const": "per_semester"
              }
            }
          },
          "then": {
            "properties": {
              "qty": {
                "type": "object",
                "properties": {
                  "semesters": {
                    "$ref": "#/$defs/quantityOrNull"
                  }
                },
                "required": [
                  "semesters"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": {
                "const": "per_month"
              }
            }
          },
          "then": {
            "properties": {
              "qty": {
                "type": "object",
                "properties": {
                  "months": {
                    "$ref": "#/$defs/quantityOrNull"
                  }
                },
                "required": [
                  "months"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": {
                "const": "package"
              }
            }
          },
          "then": {
            "properties": {
              "qty": {
                "type": "object",
                "properties": {
                  "packages": {
                    "$ref": "#/$defs/quantityOrNull"
                  }
                },
                "required": [
                  "packages"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "courseGroup": {
      "type": "object",
      "properties": {
        "stage_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "stage_key",
        "name"
      ],
      "additionalProperties": false
    },
    "stageSetting": {
      "type": "object",
      "properties": {
        "stage_key": {
          "$ref": "#/$defs/stableKey"
        },
        "pending": {
          "type": "boolean"
        },
        "pending_note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "stage_key",
        "pending",
        "pending_note"
      ],
      "additionalProperties": false
    },
    "courses": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "stage_settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stageSetting"
          },
          "maxItems": 100
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/courseGroup"
          },
          "maxItems": 200
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "maxItems": 300
        }
      },
      "required": [
        "visible",
        "title",
        "stage_settings",
        "groups",
        "lines"
      ],
      "additionalProperties": false
    },
    "teacher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "introduction": {
          "type": "string",
          "maxLength": 12000
        },
        "proposed": {
          "type": "boolean"
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "name",
        "title",
        "introduction",
        "proposed"
      ],
      "additionalProperties": false
    },
    "teacherGroup": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/teacher"
          },
          "maxItems": 60
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "role",
        "members"
      ],
      "additionalProperties": false
    },
    "teachers": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/teacherGroup"
          },
          "maxItems": 30
        }
      },
      "required": [
        "visible",
        "title",
        "groups"
      ],
      "additionalProperties": false
    },
    "customInstallment": {
      "type": "object",
      "properties": {
        "stage_key": {
          "$ref": "#/$defs/idOrNull"
        },
        "label": {
          "type": "string",
          "maxLength": 30
        },
        "due": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "ratio_bps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "stage_key",
        "label",
        "due",
        "ratio_bps"
      ],
      "additionalProperties": false
    },
    "fixedInstallment": {
      "type": "object",
      "properties": {
        "stage_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "due": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "$ref": "#/$defs/moneyOrNull"
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "stage_key",
        "label",
        "due",
        "amount"
      ],
      "additionalProperties": false
    },
    "extra": {
      "type": "object",
      "properties": {
        "stage_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "stage_key",
        "label",
        "note"
      ],
      "additionalProperties": false
    },
    "otherFee": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "required": [
        "key",
        "label",
        "note"
      ],
      "additionalProperties": false
    },
    "discount": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "none",
            "fixed",
            "percent"
          ]
        },
        "amount": {
          "$ref": "#/$defs/moneyOrNull"
        },
        "rate_bps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "type",
        "amount",
        "rate_bps",
        "note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "amount": {
                "type": "null"
              },
              "rate_bps": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "amount": {
                "$ref": "#/$defs/money"
              },
              "rate_bps": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "percent"
